# =============================================================
# HAMSAYAA - Environment Variables Configuration
# =============================================================
# INSTRUCTIONS FOR COLLABORATORS:
# 1. Copy this file to `backend/.env`
# 2. Replace all placeholder values with real credentials
# 3. Ask the project lead for shared credentials if needed
# =============================================================

# Meta WhatsApp API Secrets
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_APP_ID=your_whatsapp_app_id
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_TEST_NUMBER=+923001234567
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Primary LLM Engine (Gemini)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Connection (Supabase / Managed PostgreSQL)
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Background Jobs (Upstash Redis)
# Get these from: https://console.upstash.com → Your Database → REST API
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_URL=rediss://default:your_token@your-redis-instance.upstash.io:6379

# Per-society Configurable Defaults
SOCIETY_PAYMENT_ACCOUNT_DETAILS=Standard_Bank_Account_Number_IBAN

# Observability (Sentry)
# Get DSN from: https://sentry.io → Your Project → Settings → Client Keys
SENTRY_DSN=your_sentry_dsn
